# ======================= MQ-MAS configuration =======================
# Copy to .env for local runs. On Railway, set these as service Variables.

# --- Mode -----------------------------------------------------------
# paper (default): real market data, simulated fills. live: real orders.
TRADING_MODE=paper
# Required ONLY for live mode, exactly this phrase:
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS
INITIAL_CAPITAL_USDT=50

# --- Exchange (ccxt id) ---------------------------------------------
EXCHANGE_ID=binance
SYMBOL=BTC/USDT
# exchange | synthetic (offline demo, paper only)
MARKET_DATA_SOURCE=exchange
# Keys: SPOT trading permission ONLY. Never enable withdrawals or margin/futures.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- LLM providers (free tiers). Order of fallback: Groq -> Gemini -> OpenRouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# --- Ops ----------------------------------------------------------------
# Protects POST /api/kill-switch (header X-Admin-Token)
ADMIN_TOKEN=change-me-to-a-long-random-string
DB_PATH=./data/mqmas.db
LOG_LEVEL=INFO

# --- Risk (can only be TIGHTENED; looser values refuse to boot) -------------
MAX_RISK_PER_TRADE_PCT=0.006
STOP_LOSS_MAX_PCT=0.006
STOP_LOSS_MIN_PCT=0.003
TAKE_PROFIT_MIN_PCT=0.006
TAKE_PROFIT_MAX_PCT=0.008
FEE_RATE=0.001
MAX_SLIPPAGE_PCT=0.0005
CONSECUTIVE_LOSS_LIMIT=2
LOCKOUT_HOURS=24
MAX_DAILY_LOSS_PCT=0.015

# --- Statistical gates ---------------------------------------------------
ZSCORE_ENTRY=-2.0
ZSCORE_PRECHECK=-1.5
MIN_WIN_RATE=0.75
MIN_SAMPLE_SIZE=20
MIN_TRADE_SHARPE=0.20
KELLY_FRACTION=0.25

# --- Trend allocator (python -m mqmas.runner, one tick per cron run) -------------
# Validated on Binance 2020-01→2026-10 (python -m mqmas.research ./data/research trend).
# Below ~US$ 120 Binance's US$ 5 minimum order leaves most of the capital idle.
# Two desks share the account. Recommended split (waves study, Binance 2020-01→2026-10, US$ 120 account,
# costs included): 70 % trend + 30 % wave hunter → CAGR +62 %, max drawdown 38 %, Sharpe 1.45.
TREND_CAPITAL_USDT=84
TREND_VOL_TARGET=0.60
TREND_TOP_N=20
TREND_MAX_WEIGHT=0.35
TREND_MAX_DRAWDOWN=0.45
# Wave hunter: weekly top-5 momentum while BTC > 100-day average (0 = off). Historical drawdown 67 %.
ONDAS_CAPITAL_USDT=36
ONDAS_MAX_DRAWDOWN=0.70
# Investment committee (tecnico, fundamentalista, sentimento, risco). Empty = all in shadow (recommended
# until the scoreboard, python -m mqmas.runner --placar, shows who helps).
TREND_COMMITTEE=true
TREND_ACTIVE_SPECIALISTS=
# Real orders need TRADING_MODE=live + LIVE_TRADING_CONFIRM AND this second switch:
TREND_LIVE_ENABLED=false
# true = sell everything on the next run and stay flat
TREND_KILL_SWITCH=false
# Free alerts: Telegram bot (@BotFather) + a healthchecks.io ping that alerts you when runs stop
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# HEARTBEAT_URL=https://hc-ping.com/<uuid>
