# ===================== Product Studio — virtual office =====================
# Copy to .env for local runs. On Railway, set these as service Variables.
# Every key is optional: what is missing is switched off, and the office keeps running.

# --- Core --------------------------------------------------------------------
# Railway: reference the Postgres plugin, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db
# Empty = in-process queue (cheapest). Set only if you add a Redis service + separate worker.
REDIS_URL=
# Public URL of this service (landing pages, download links, Stripe redirect)
PUBLIC_BASE_URL=http://localhost:8000
# Protects "Run cycle" and "Approve & publish" in the office UI (header X-Admin-Token)
ADMIN_TOKEN=change-me-to-a-long-random-string
ARTIFACTS_DIR=./data/artifacts

# --- Autonomy ------------------------------------------------------------------
PIPELINE_INTERVAL_MIN=30
RESEARCH_INTERVAL_MIN=360
IDEAS_PER_RESEARCH=3
MAX_BUILDS_PER_DAY=2
# false: ready products wait for one click from the CEO. true: Leo publishes on his own.
AUTOPUBLISH=false
# Nina's audit: products with no sale after 42 days get their Stripe link deactivated. false = only recommend.
AUTOPAUSE_STALE=false
# Seconds between lines in meetings (so you can watch the conversation)
THEATRE_DELAY_SEC=3

# --- Free AI providers (cascade Groq -> Gemini -> OpenRouter -> built-in playbook) ----
# Groq: https://console.groq.com/keys · Gemini: https://aistudio.google.com/apikey · OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_DAILY_CALL_BUDGET=400

# --- Research (free) -------------------------------------------------------------
# Reddit "script" app (https://www.reddit.com/prefs/apps) makes Reddit reliable from cloud IPs
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=n8n,automation,Entrepreneur,smallbusiness,SaaS,indiehackers,solopreneur,freelance
# Product Hunt developer token (optional)
PRODUCTHUNT_TOKEN=
RESEARCH_OFFLINE=false

# --- Sales platforms -----------------------------------------------------------------
# Stripe: fully automatic (product + price + payment link). Webhook: <PUBLIC_BASE_URL>/webhooks/stripe
#   events: checkout.session.completed, charge.refunded, checkout.session.expired, payment_intent.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Gumroad: sales via ping URL <PUBLIC_BASE_URL>/webhooks/gumroad?key=<GUMROAD_WEBHOOK_SECRET>
GUMROAD_ACCESS_TOKEN=
GUMROAD_WEBHOOK_SECRET=
# Whop: API v1 products + one-time plans. Webhook: <PUBLIC_BASE_URL>/webhooks/whop
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=

# --- Delivery & CEO alerts (free tiers) -------------------------------------------------
# Resend (3,000 emails/month free) sends the buyer's download link
RESEND_API_KEY=
EMAIL_FROM=Studio <onboarding@resend.dev>
DOWNLOAD_TTL_DAYS=30
DOWNLOAD_MAX=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Finance (USD per month; check Railway -> Usage and adjust) ---------------------------
RAILWAY_WEB_USD=5
RAILWAY_POSTGRES_USD=2
RAILWAY_REDIS_USD=0
RAILWAY_N8N_USD=0
OTHER_MONTHLY_USD=0

# --- Goals ------------------------------------------------------------------------------
GOAL_MONTHLY_REVENUE_USD=500
GOAL_PRODUCTS_PER_WEEK=2
GOAL_IDEAS_PER_WEEK=15
